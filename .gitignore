# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Built skill zip (scripts/build_zip.py) - rebuilt from HEAD, never committed
dist/

# Local-only on the PC: run journal and files set aside for deletion
/log/
_to_delete/
